page { background: #f5f7fa; color: #192536; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif; }
.room-page { padding: 30rpx 36rpx 52rpx; }
.room-heading { font-size: 42rpx; font-weight: 700; line-height: 1.45; margin: 12rpx 0; }
.room-subtitle { color: #526173; font-size: 26rpx; line-height: 1.8; margin-bottom: 28rpx; }
.room-card { background: #fff; border: 2rpx solid #dce2e9; border-radius: 22rpx; padding: 28rpx; margin-bottom: 24rpx; }
.room-label { font-size: 29rpx; font-weight: 600; line-height: 1.6; margin-bottom: 16rpx; }
.room-hint { color: #596777; font-size: 23rpx; line-height: 1.8; margin-top: 12rpx; overflow-wrap: break-word; }
.room-detail { color: #526173; font-size: 24rpx; font-weight: 400; }
.room-summary { background: #edf1f4; border-radius: 12rpx; padding: 18rpx 20rpx; color: #526173; font-size: 25rpx; line-height: 1.9; margin: 22rpx 0; }
.room-page .room-button { position: relative; display: block; width: 100%; min-width: 0; box-sizing: border-box; min-height: 88rpx; margin: 18rpx 0 0; padding: 20rpx 22rpx; font-family: inherit; font-size: 28rpx; font-weight: 600; line-height: 1.6; border: 2rpx solid #17664e; border-radius: 16rpx; white-space: normal; }
.room-page .room-button::after { border: none; }
.room-page .primary { background: #17664e; color: #fff; }
.room-page .secondary { background: #fff; color: #17664e; border-color: #c8d8cf; }
.room-page .quiet { background: transparent; color: #526173; border-color: transparent; font-weight: 400; }
.room-page .room-button[disabled] { background: #edf1f4; color: #7b8997; border-color: #dce2e9; }
.room-banner { background: #fff3df; border: 2rpx solid #ead7b3; border-radius: 14rpx; padding: 18rpx 20rpx; font-size: 24rpx; line-height: 1.8; color: #795526; margin-bottom: 20rpx; }
.demo-banner { font-weight: 600; }
.room-mode { font-size: 23rpx; line-height: 1.7; color: #526173; margin-bottom: 24rpx; }
.room-page .mode-switch { min-height: 88rpx; padding: 16rpx 18rpx; margin-top: 8rpx; background: #fff; color: #17664e; border-color: #c8d8cf; font-size: 24rpx; }
.room-error { color: #a43426; background: #fff4f2; padding: 14rpx 18rpx; border-radius: 12rpx; margin: 16rpx 0; font-size: 25rpx; line-height: 1.8; }
.room-notice { color: #36614f; background: #eaf4ee; padding: 14rpx 18rpx; border-radius: 12rpx; margin: 16rpx 0; font-size: 24rpx; line-height: 1.8; }
.room-config { padding-top: 26rpx; }
.room-config .room-label { margin-top: 26rpx; }
.room-options { display: flex; margin: 0 -6rpx; }
.room-page .room-option { flex: 1; width: 0; min-width: 0; margin: 0 6rpx; padding: 20rpx 6rpx; background: #f5f7fa; color: #334155; border-color: #dce2e9; font-size: 26rpx; }
.room-page .room-option.selected { background: #eaf4ee; border-color: #17664e; color: #104f3c; }
.room-input, .room-picker { box-sizing: border-box; width: 100%; height: 96rpx; border: 2rpx solid #c7d1dc; border-radius: 14rpx; padding: 0 22rpx; color: #192536; background: #fff; font-size: 32rpx; }
.room-picker { display: flex; align-items: center; justify-content: space-between; height: auto; min-height: 96rpx; padding: 20rpx 22rpx; line-height: 1.7; font-size: 28rpx; }
.picker-arrow { margin-left: 20rpx; color: #526173; }
.code-input { font-size: 38rpx; letter-spacing: 8rpx; }
.code-card { text-align: center; }
.room-code { display: block; font-family: Consolas, monospace; font-size: 64rpx; font-weight: 700; letter-spacing: 9rpx; color: #17664e; margin: 18rpx 0; }
.members-heading { display: flex; justify-content: space-between; font-size: 29rpx; font-weight: 600; margin-bottom: 16rpx; }
.room-member { display: flex; align-items: center; padding: 18rpx 0; min-height: 76rpx; }
.room-member + .room-member { border-top: 2rpx solid #edf0f4; }
.room-avatar { flex: none; width: 68rpx; height: 68rpx; border-radius: 50%; text-align: center; line-height: 68rpx; font-size: 27rpx; background: #eaf4ee; color: #17664e; margin-right: 18rpx; }
.member-empty .room-avatar { background: #f1f4f7; color: #7b8997; }
.member-info { flex: 1; min-width: 0; }
.member-name { font-size: 27rpx; font-weight: 600; line-height: 1.5; }
.member-info .room-hint { margin-top: 4rpx; }
.member-status { flex: none; margin-left: 14rpx; font-size: 23rpx; color: #657487; }
.ready-status { color: #17664e; }
.room-centered { text-align: center; padding-top: 20rpx; }
.room-badge { display: inline-block; color: #17664e; background: #eaf4ee; font-size: 24rpx; border-radius: 10rpx; padding: 8rpx 16rpx; margin-bottom: 18rpx; }
.count-circle { width: 206rpx; height: 206rpx; line-height: 206rpx; border-radius: 50%; background: #eaf4ee; color: #17664e; font-size: 114rpx; font-weight: 700; margin: 44rpx auto; }
.state-symbol { width: 140rpx; height: 140rpx; line-height: 140rpx; border-radius: 50%; background: #edf1f4; color: #526173; font-size: 54rpx; margin: 20rpx auto 36rpx; }
.room-demo-tools { margin-top: 40rpx; padding-top: 28rpx; border-top: 2rpx solid #dce2e9; }
.demo-grid { display: flex; flex-wrap: wrap; margin: 0 -6rpx; }
.room-page .demo-tool { width: calc(50% - 12rpx); flex: none; margin: 12rpx 6rpx 0; font-size: 23rpx; color: #526173; background: #fff; border-color: #dce2e9; }
