<view class="page">
  <view class="hero">
    <image class="avatar" src="/assets/avatar.png" mode="aspectFit" />
    <view class="title">口算小搭档</view>
    <view class="subtitle">每天练一练，和数字交朋友</view>
  </view>
  <view class="status">开发验收版 · 比赛需联网</view>
  <view class="card">
    <view class="card-title">单人练习</view>
    <view class="note">选择年级、题型和题量，可自由练习，也可限时挑战。</view>
    <button class="primary" bindtap="openPractice">进入单人练习</button>
    <button wx:if="{{hasDraft}}" class="secondary" bindtap="continuePractice">继续上次练习</button>
    <view wx:if="{{draftError}}" class="note">{{draftError}}</view>
  </view>
  <view class="card">
    <view class="card-title">双人答题</view>
    <view class="note">和一位伙伴完成同一组题目。</view>
    <button class="primary" bindtap="openRoom">进入双人比赛</button>
  </view>
  <button class="primary" bindtap="openHistory">练习记录</button>
</view>
