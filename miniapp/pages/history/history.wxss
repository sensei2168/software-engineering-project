/* 练习记录页专用样式。配色沿用 app.wxss：主色 #087f79，底色 #fffcf3。 */

.record {
  margin-bottom: 20rpx;
}

.rec-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.rec-time {
  font-size: 27rpx;
  color: #3f5f5c;
}

.rec-dev {
  font-size: 21rpx;
  color: #795526;
  background: #fff1d7;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}

.rec-stats {
  display: flex;
  align-items: flex-end;
}

.rec-stat {
  text-align: center;
  margin-right: 36rpx;
}

.rec-num {
  font-size: 38rpx;
  font-weight: 700;
  color: #183f40;
}

.rec-num.ok { color: #1a7f5a; }
.rec-num.acc { color: #087f79; }

.rec-lab {
  font-size: 22rpx;
  color: #657773;
  margin-top: 4rpx;
}

.rec-mode {
  flex: 1;
  text-align: right;
  font-size: 23rpx;
  color: #879a96;
}

.rec-arrow {
  font-size: 38rpx;
  color: #c3d3cf;
  padding-left: 12rpx;
}

.foot-note {
  color: #879a96;
  font-size: 23rpx;
  line-height: 1.7;
  text-align: center;
  margin: 32rpx 12rpx 0;
}

.dev-hint {
  color: #795526;
  font-size: 23rpx;
  line-height: 1.6;
  margin-top: 14rpx;
}
