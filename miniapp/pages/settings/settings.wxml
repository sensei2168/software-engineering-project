<view class="page settings-page">
  <view class="settings-heading">这次想练什么？</view>
  <view class="settings-description">选好题型和题量，下一步核对练习设置。</view>
  <view class="settings-panel">
    <view class="setting-group">
      <view class="setting-label">练习方式</view>
      <view class="option-row">
        <button class="setting-option mode-option {{config.mode === 'normal' ? 'is-selected' : ''}}" data-value="normal" bindtap="chooseMode" hover-class="option-pressed"><view>普通练习</view><view class="option-description">不限时</view><text wx:if="{{config.mode === 'normal'}}" class="option-check">✓</text></button>
        <button class="setting-option mode-option {{config.mode === 'timed' ? 'is-selected' : ''}}" data-value="timed" bindtap="chooseMode" hover-class="option-pressed"><view>限时练习</view><view class="option-description">自选时长</view><text wx:if="{{config.mode === 'timed'}}" class="option-check">✓</text></button>
      </view>
    </view>
    <view class="setting-group">
      <view class="setting-label">题型<text class="label-detail">20 以内</text></view>
      <view class="option-row">
        <button class="setting-option operation-option {{config.operation === 'add' ? 'is-selected' : ''}}" data-value="add" bindtap="chooseOperation" hover-class="option-pressed"><text class="operation-symbol">＋</text><text>加法</text><text wx:if="{{config.operation === 'add'}}" class="option-check">✓</text></button>
        <button class="setting-option operation-option {{config.operation === 'subtract' ? 'is-selected' : ''}}" data-value="subtract" bindtap="chooseOperation" hover-class="option-pressed"><text class="operation-symbol">−</text><text>减法</text><text wx:if="{{config.operation === 'subtract'}}" class="option-check">✓</text></button>
      </view>
    </view>
    <view class="setting-group">
      <view class="setting-label">题量<text class="label-detail">10—50 道</text></view>
      <view class="count-box {{error ? 'count-box-error' : ''}}"><input class="count-input" type="number" maxlength="3" value="{{countText}}" bindinput="changeCount" placeholder="输入题量" placeholder-class="count-placeholder" confirm-type="done" aria-label="题量，10到50之间的整数" /><text class="count-unit">道</text></view>
      <view class="field-error" wx:if="{{error}}">{{error}}</view>
      <view class="field-hint" wx:else>可以修改数字，默认每组 30 道。</view>
    </view>
    <view class="setting-group duration-group" wx:if="{{config.mode === 'timed'}}">
      <view class="setting-label">练习时长</view>
      <view class="option-row">
        <button wx:for="{{durations}}" wx:key="*this" class="setting-option duration-option {{config.durationSeconds === item ? 'is-selected' : ''}}" data-value="{{item}}" bindtap="chooseDuration" hover-class="option-pressed">{{item}} 秒<text wx:if="{{config.durationSeconds === item}}" class="duration-check">✓</text></button>
      </view>
      <view class="field-hint">进入实际答题后才开始计时。</view>
    </view>
  </view>
  <button class="settings-submit" bindtap="previewPractice" hover-class="submit-pressed">确认设置，查看下一页<text class="submit-arrow">→</text></button>
  <view class="settings-footnote">当前为设置预览，下一页可核对参数，暂不生成题目。</view>
</view>
