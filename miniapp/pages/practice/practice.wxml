<view class="page practice-page">
  <view class="status" wx:if="{{loading && !error}}">正在出题，请稍候</view>

  <block wx:if="{{error}}">
    <view class="status">设置无效</view>
    <view class="card">
      <view class="error">{{error}}</view>
    </view>
    <button class="primary" bindtap="backToSettings">返回练习设置</button>
  </block>

  <block wx:if="{{!error && unavailable}}">
    <view class="status">即将开放</view>
    <view class="card">
      <view class="card-title">{{unavailable.title}}</view>
      <view class="summary-line" wx:if="{{display}}">本次选择：{{display.gradeLabel}} · {{display.ruleLabel}} · {{display.rangeLabel}}</view>
      <view class="note">{{unavailable.message}}</view>
      <view class="note">目前 13 个设置预设都已接入出题与判分。如果出现本提示，说明题型配置异常，请返回设置重新选择。</view>
    </view>
    <button class="primary" bindtap="backToSettings">返回练习设置</button>
  </block>

  <block wx:if="{{!error && !unavailable && loadError}}">
    <view class="status">出题失败</view>
    <view class="card">
      <view class="error">{{loadError}}</view>
    </view>
    <button class="primary" bindtap="retry">重新出题</button>
    <button class="secondary" bindtap="backToSettings">返回设置</button>
  </block>

  <block wx:if="{{!error && !unavailable && !loadError && total > 0}}">
    <view class="quiz-head">
      <view class="quiz-progress">第 {{currentIndex + 1}} / {{total}} 题</view>
      <view wx:if="{{timed}}" class="quiz-timer {{remainingSeconds <= 10 ? 'urgent' : ''}}">{{remainingText}}</view>
    </view>

    <view class="quiz-card">
      <view class="quiz-hint">{{display.gradeLabel}} · {{display.ruleLabel}} · {{display.rangeLabel}} · {{config.mode === 'timed' ? '限时' : '不限时'}}</view>
      <view class="quiz-question">{{currentText}}</view>
      <view wx:if="{{fractionMode}}" class="quiz-fraction">
        <view class="fraction-inputs">
          <input
            class="fraction-input"
            type="number"
            maxlength="2"
            value="{{fractionNumerator}}"
            placeholder="分子"
            placeholder-class="fraction-placeholder"
            focus="{{inputFocus && !finished}}"
            disabled="{{finished}}"
            data-part="numerator"
            bindinput="onFractionInput"
          />
          <view class="fraction-bar"></view>
          <input
            class="fraction-input"
            type="number"
            maxlength="2"
            value="{{fractionDenominator}}"
            placeholder="分母"
            placeholder-class="fraction-placeholder"
            disabled="{{finished}}"
            data-part="denominator"
            bindinput="onFractionInput"
          />
        </view>
      </view>
      <view wx:else class="quiz-answer">
        <input
          class="quiz-input"
          type="{{inputType}}"
          maxlength="{{inputMaxLength}}"
          value="{{currentValue}}"
          placeholder="?"
          placeholder-class="quiz-placeholder"
          focus="{{inputFocus && !finished}}"
          disabled="{{finished}}"
          data-index="{{currentIndex}}"
          bindinput="onAnswerInput"
          confirm-type="next"
          bindconfirm="nextQuestion"
        />
      </view>
      <view class="quiz-tip">{{finished ? '本次已交卷，可以翻看各题答案' : (fractionMode ? '分子、分母都要填；整数 0 写成 0/1，1 写成 1/1' : '输入答案后点“下一题”，可随时返回修改')}}</view>
    </view>

    <view class="quiz-actions">
      <button class="choice quiz-nav" bindtap="prevQuestion" disabled="{{currentIndex === 0}}">上一题</button>
      <button class="choice quiz-nav" bindtap="nextQuestion" disabled="{{currentIndex + 1 >= total}}">下一题</button>
    </view>

    <view class="quiz-footer">
      <view class="quiz-count">已填 {{answeredCount}} / {{total}}</view>
      <button class="primary" bindtap="onSubmitTap" loading="{{submitting}}" disabled="{{submitting || finished}}">{{finished ? '已交卷' : '交卷并批改'}}</button>
    </view>
  </block>
</view>
