/* 答题页：题干大字号、输入框居中；上一题/下一题在输入框下方，交卷按钮再往下。
   键盘弹起时交卷按钮可能被遮住，收起键盘后即可滚动到并点击。 */
.practice-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding-bottom: 60rpx;
}

.quiz-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.quiz-progress {
  color: #597374;
  font-size: 28rpx;
}

.quiz-timer {
  font-family: "SF Mono", Menlo, monospace;
  font-size: 40rpx;
  font-weight: 700;
  color: #087f79;
  padding: 4rpx 20rpx;
  background: #eef7f4;
  border-radius: 14rpx;
}

.quiz-timer.urgent {
  color: #a43426;
  background: #fdeceb;
}

.quiz-card {
  background: #fff;
  border: 2rpx solid #e3efeb;
  border-radius: 28rpx;
  padding: 40rpx 30rpx 32rpx;
  text-align: center;
}

.quiz-hint {
  color: #8aa09d;
  font-size: 24rpx;
  margin-bottom: 20rpx;
}

.quiz-question {
  font-size: 92rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  line-height: 1.4;
  color: #183f40;
  margin-bottom: 24rpx;
}

.quiz-answer {
  display: flex;
  justify-content: center;
}

.quiz-input {
  width: 340rpx;
  height: 120rpx;
  line-height: 120rpx;
  text-align: center;
  font-size: 72rpx;
  font-weight: 700;
  color: #087f79;
  background: #f3f7f5;
  border-radius: 20rpx;
  border-bottom: 4rpx solid #cfe3de;
}

.quiz-placeholder {
  color: #c3d3d0;
  font-size: 72rpx;
}

.quiz-fraction {
  display: flex;
  justify-content: center;
}

.fraction-inputs {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.fraction-input {
  width: 200rpx;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  font-size: 52rpx;
  font-weight: 700;
  color: #087f79;
  background: #f3f7f5;
  border-radius: 16rpx;
}

.fraction-bar {
  width: 220rpx;
  height: 4rpx;
  background: #183f40;
  margin: 10rpx 0;
}

.fraction-placeholder {
  color: #c3d3d0;
  font-size: 32rpx;
  font-weight: 400;
}

.quiz-tip {
  color: #8aa09d;
  font-size: 24rpx;
  margin-top: 20rpx;
}

.quiz-actions {
  display: flex;
  justify-content: space-between;
  margin-top: 26rpx;
}

.quiz-nav {
  flex: 1;
  margin: 0 10rpx;
}

.quiz-footer {
  margin-top: 12rpx;
  padding-bottom: 40rpx;
}

.quiz-count {
  text-align: center;
  color: #597374;
  font-size: 26rpx;
  margin-bottom: 8rpx;
}

/* 交卷后的统计横幅 */
.review-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #eef7f4;
  border: 2rpx solid #cfe3de;
  border-radius: 20rpx;
  padding: 18rpx 24rpx;
  margin-bottom: 20rpx;
}

.review-summary {
  font-size: 26rpx;
  color: #216b67;
}

.review-result-btn {
  margin: 0;
  padding: 0 24rpx;
  font-size: 24rpx;
  line-height: 56rpx;
  background: #087f79;
  color: #fff;
  border-radius: 14rpx;
}

/* 回顾状态：只读展示用户答案与正确答案 */
.review-panel {
  text-align: left;
  background: #f7faf9;
  border-radius: 18rpx;
  padding: 24rpx;
  margin-top: 16rpx;
}

.review-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 10rpx 0;
}

.review-label {
  color: #597374;
  font-size: 26rpx;
}

.review-value {
  font-size: 34rpx;
  font-weight: 700;
}

.review-user-correct {
  color: #1a7f4b;
}

.review-user-wrong {
  color: #a43426;
}

.review-user-blank {
  color: #b26a00;
}

.review-answer-correct {
  color: #1a7f4b;
}

.review-note {
  color: #8aa09d;
  font-size: 24rpx;
  margin-top: 8rpx;
}

/* 题目导航：圆角小方块，作答时灰/绿边，交卷后绿/红/橙 */
.nav-card {
  background: #fff;
  border: 2rpx solid #e3efeb;
  border-radius: 24rpx;
  padding: 24rpx 20rpx;
  margin-top: 24rpx;
}

.nav-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.nav-title {
  font-size: 30rpx;
  font-weight: 600;
}

.nav-sub {
  color: #8aa09d;
  font-size: 22rpx;
}

.nav-grid {
  display: flex;
  flex-wrap: wrap;
}

.nav-cell {
  width: 70rpx;
  height: 70rpx;
  line-height: 70rpx;
  text-align: center;
  border-radius: 16rpx;
  margin: 7rpx;
  font-size: 26rpx;
  border: 2rpx solid transparent;
}

.nav-unanswered {
  background: #f1f5f3;
  color: #9aa8a5;
  border-color: #e3efeb;
}

.nav-answered {
  background: #fff;
  color: #087f79;
  border-color: #087f79;
}

.nav-correct {
  background: #e6f4ea;
  color: #1a7f4b;
  border-color: #1a7f4b;
}

.nav-wrong {
  background: #fdeceb;
  color: #a43426;
  border-color: #a43426;
}

.nav-blank {
  background: #fff4e5;
  color: #b26a00;
  border-color: #b26a00;
}

.nav-current {
  box-shadow: 0 0 0 4rpx #087f79;
  font-weight: 700;
}

.nav-legend {
  display: flex;
  flex-wrap: wrap;
  margin-top: 8rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  margin-right: 24rpx;
  color: #597374;
  font-size: 22rpx;
}

.legend-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 6rpx;
  margin-right: 8rpx;
}

.dot-unanswered {
  background: #e3efeb;
}

.dot-answered {
  background: #087f79;
}

.dot-current {
  background: #087f79;
  box-shadow: 0 0 0 3rpx #cfe3de;
}

.dot-correct {
  background: #1a7f4b;
}

.dot-wrong {
  background: #a43426;
}

.dot-blank {
  background: #b26a00;
}
